# Cloudflare Worker Environment Variables & Secrets
# Copy this to .dev.vars for local development with `wrangler dev`

# Base URL of this service (used for unsubscribe links, emails, and CORS)
APP_URL=http://localhost:8787

# Admin dashboard authentication password
ADMIN_PASSWORD=change-me-to-a-secure-password

# Secret key for signing unsubscribe tokens and session cookies
SIGNING_SECRET=generate-a-secure-random-32-byte-hex-string

# Optional fallback Resend API Key (individual sites can override with their own key in the Admin UI)
RESEND_API_KEY=re_1234567890abcdef

# Environment name
ENVIRONMENT=development

# Cloudflare Resource IDs (fill in after running setup commands in SELF-HOST.md)
# CLOUDFLARE_ACCOUNT_ID=
# D1_DATABASE_ID=
# KV_NAMESPACE_ID=
